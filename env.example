# ============================================
# Screenshot API Configuration
# ============================================

# Client-side API key (exposed to browser)
# This is used by the API client to authenticate with /api/screenshot
# Must match SCREENSHOT_API_KEY for authentication to succeed
NEXT_PUBLIC_SCREENSHOT_API_KEY=your-secret-api-key-here

# Server-side API key (NOT exposed to browser)
# This is used by /api/screenshot/route.ts to validate incoming requests
# Must match NEXT_PUBLIC_SCREENSHOT_API_KEY
SCREENSHOT_API_KEY=your-secret-api-key-here

# Optional: Base URL for the screenshot API
# Defaults to current origin if not set
# NEXT_PUBLIC_SCREENSHOT_API_BASE_URL=http://localhost:3000

# Optional: External screenshot service URL
# Used by /api/screenshot to forward requests to external service
# SCREENSHOT_API_BASE_URL=http://localhost:3001

# Optional: Custom screenshot endpoint path
# SCREENSHOT_ENDPOINT_PATH=/screenshot

# ============================================
# Database Configuration (Supabase)
# ============================================

NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# Security Notes
# ============================================

# 1. NEVER commit .env.local to version control
# 2. Keep API keys secret and rotate them regularly
# 3. Use different keys for development and production
# 4. Client-side keys (NEXT_PUBLIC_*) are visible in browser
# 5. Server-side keys are only accessible on the server

# ============================================
# Quick Setup
# ============================================

# 1. Copy this file to .env.local:
#    cp env.example .env.local
#
# 2. Generate a secure API key:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 3. Replace 'your-secret-api-key-here' with the generated key
#
# 4. Make sure both NEXT_PUBLIC_SCREENSHOT_API_KEY and SCREENSHOT_API_KEY match
#
# 5. Restart your development server:
#    npm run dev